# Salin file ini menjadi .env lalu sesuaikan bila perlu:
#   cp .env.example .env
# Jika .env tidak ada, docker compose memakai default di bawah.

# --- Database MySQL ---
MYSQL_ROOT_PASSWORD=root_secret
DB_NAME=tracker
DB_USER=tracker
DB_PASS=tracker_secret

# --- Aplikasi (CodeIgniter) ---
CI_ENV=development
DB_HOST=db

# --- Lainnya ---
TZ=Asia/Jakarta
# Port publik aplikasi (format "ip:port" atau hanya "port")
APP_PORT=127.0.0.1:3000
